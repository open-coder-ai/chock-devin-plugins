{
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "git -c \"alias.chock-sh=!sh\" chock-sh \"$DEVIN_PLUGIN_ROOT/scripts/launch.sh\" \"$DEVIN_PLUGIN_ROOT/scripts/devin.py\" --guard \"$DEVIN_PLUGIN_ROOT/scripts/block-unapproved-egress.py\"",
          "timeout": 30
        }
      ]
    }
  ]
}
